<RCC>
  <qresource prefix="/icons">
    <file alias="app.png">assets/icons/app.png</file>
    <file alias="save.svg">assets/icons/save.svg</file>
    <file alias="cancel.svg">assets/icons/cancel.svg</file>
    <file alias="rename.svg">assets/icons/rename.svg</file>
    <file alias="trash.svg">assets/icons/trash.svg</file>
    <file alias="add.svg">assets/icons/add.svg</file>
    <file alias="down.svg">assets/icons/down.svg</file>
    <file alias="up.svg">assets/icons/up.svg</file>
    <file alias="help.svg">assets/icons/help.svg</file>
  </qresource>

  <qresource prefix="/docs">
    <file alias="help.en.md">assets/docs/HELP.en.md</file>
    <file alias="help.tr.md">assets/docs/HELP.tr.md</file>
    <file alias="help.fr.md">assets/docs/HELP.fr.md</file>
    <file alias="help.de.md">assets/docs/HELP.de.md</file>
  </qresource>

<!--   <qresource prefix="/translations"> -->
